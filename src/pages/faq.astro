---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: "Who built MyMailhub and why?",
    a: "MyMailhub was built by independent pack-and-ship store operators at Mailbox Plus in Ohio. We were fed up with legacy software that forced 6-month paper leases, required dedicated flatbed scanner hardware, and crashed on tablet updates. We needed a system fast enough to handle our real 3:00 PM carrier rushes."
  },
  {
    q: "How does the assisted roster migration work?",
    a: "You do not have to manually re-type your customer list. If you use CashMate, PostalMate, QuickBooks, or a spreadsheet, export your customer data to Excel or CSV. On your onboarding call, we sanitize, format, and load your customers, box numbers, phone numbers, and authorized addressees directly into your account."
  },
  {
    q: "Do I have to buy special scanners or barcode guns?",
    a: "No. MyMailhub runs on any standard web browser using the camera on any iPad, Android tablet, smartphone, or laptop already sitting behind your counter. You never have to purchase proprietary scanner hardware."
  },
  {
    q: "Why don't you offer an APK download or native app store download?",
    a: "Because sideloading unverified APK files bypasses your device's security protocols and creates massive vulnerability. Even worse, native apps frequently break whenever Apple or Google releases a major OS update—paralyzing your counter in the middle of a rush. MyMailhub runs securely in modern browsers as an encrypted cloud application that updates automatically with zero downtime."
  },
  {
    q: "Are there any contracts, leases, or cancellation penalties?",
    a: "None. MyMailhub is $39/month flat. We don't ask for a 6-month paper lease or a 30-day cancellation notice. If you ever decide to leave, cancel with one click and export your complete historical data."
  },
  {
    q: "Do I need to create and pay for my own Twilio or email account?",
    a: "No. Outbound SMS and email notifications are fully integrated out-of-the-box. You don't have to navigate carrier A2P 10DLC compliance or configure SMTP passwords."
  },
  {
    q: "What happens if a counter tablet breaks or gets dropped?",
    a: "Nothing is lost. Because MyMailhub is cloud-backed and continuously synchronized, customer records, package logs, and signature histories are never trapped on a single local device. Simply pick up any other phone, tablet, or computer, log in, and continue scanning immediately."
  }
];
---

<Layout title="Frequently Asked Questions | MyMailhub" description="Common questions about MyMailhub counter intake software: Assisted migration, hardware requirements, security, and contract-free terms.">
  <section class="pt-20 pb-16 bg-gradient-to-b from-navy/50 via-black to-black border-b border-border-subtle">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-navy border border-border-subtle text-xs font-semibold text-gold mb-6">
        No Corporate Speak • Plain Answers
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
        Frequently Asked Questions
      </h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Everything you need to know about switching your store's intake workflow to MyMailhub.
      </p>
    </div>
  </section>

  <!-- FAQS LIST -->
  <section class="py-20 bg-black">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {faqs.map(faq => (
        <div class="p-8 rounded-2xl bg-navy/30 border border-border-subtle hover:border-gold/30 transition-colors">
          <h3 class="text-xl font-bold text-white mb-3">{faq.q}</h3>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">{faq.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-black border-t border-border-subtle text-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white mb-3">Have a question not answered here?</h2>
      <p class="text-sm text-slate-300 mb-6">Book a 15-minute call directly with our operator team.</p>
      <a 
        href="https://cal.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center px-6 py-3 rounded-xl text-sm font-bold bg-gold text-black hover:bg-gold-hover transition-colors"
      >
        Book a Quick Call &rarr;
      </a>
    </div>
  </section>
</Layout>
