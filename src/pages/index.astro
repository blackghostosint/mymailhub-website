---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Front Counter Intake Software for Pack & Ship Stores">
  <!-- HERO SECTION: SB7 Step 1 (The Hero & Core Desire) -->
  <section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden bg-gradient-to-b from-navy/60 via-black to-black border-b border-border-subtle">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Operator Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-navy border border-border-subtle text-xs font-semibold text-gold mb-8 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
        Built and operating on our own front counter today
      </div>

      <!-- Main Headline: Operational Reality over Stopwatch Promises -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
        Package intake without the front-desk scramble.
      </h1>

      <!-- Subhead: Unbroken Motion + Freedom from Vendor Handcuffs -->
      <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed">
        Scan the label. Auto-match the mailbox. Text the customer before they call your front desk. Reclaim hours of counter chaos with zero paper leases, zero flatbed scanners, and zero hardware lock-in.
      </p>

      <!-- Dual CTA Buttons (D5 Locked: Video walkthrough primary, Cal.com secondary) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
        <a 
          href="#demo" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold bg-gold text-black hover:bg-gold-hover transition-all shadow-lg shadow-gold/10"
        >
          Watch 2-Minute Walkthrough
        </a>
        <a 
          href="https://cal.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-white border border-border-subtle hover:border-slate-300 hover:bg-white/5 transition-all"
        >
          Book Onboarding Call
        </a>
      </div>

      <!-- Trust Microcopy -->
      <p class="text-xs text-slate-400">
        $39/month flat. Everything included. No setup fees. Cancel anytime.
      </p>
    </div>
  </section>

  <!-- SB7 STEP 2: THE PROBLEM & THE AFTERNOON SQUEEZE -->
  <section class="py-20 md:py-28 bg-black border-b border-border-subtle">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold text-gold uppercase tracking-widest mb-3">The Counter Reality</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          The 3:00 PM carrier rush shouldn't paralyze your front desk.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-navy/40 border border-border-subtle">
          <div class="w-12 h-12 rounded-xl bg-black border border-border-subtle flex items-center justify-center text-gold mb-6 font-bold text-lg">
            01
          </div>
          <h3 class="text-xl font-bold text-white mb-3">The Afternoon Dump</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            UPS and FedEx drop 40 boxes in your lobby. Your staff spends the next two hours typing tracking numbers and squinting at handwritten labels while walk-in customers wait in line.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-navy/40 border border-border-subtle">
          <div class="w-12 h-12 rounded-xl bg-black border border-border-subtle flex items-center justify-center text-gold mb-6 font-bold text-lg">
            02
          </div>
          <h3 class="text-xl font-bold text-white mb-3">The Constant Interruptions</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Every 10 minutes, the store phone rings: <em>"Did my medicine come in?" "Is my package there yet?"</em> Your staff drops what they are doing to search through piles on the back shelf.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-navy/40 border border-border-subtle">
          <div class="w-12 h-12 rounded-xl bg-black border border-border-subtle flex items-center justify-center text-gold mb-6 font-bold text-lg">
            03
          </div>
          <h3 class="text-xl font-bold text-white mb-3">The Vendor Handcuffs</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Legacy software demands 6-month paper leases, sideloaded Android APKs, tethered flatbed scanners, and stores your data unencrypted on a single fragile tablet. Drop the tablet, lose your records.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SB7 STEPS 3 & 4: THE GUIDE & THE 3-STEP COUNTER PLAN -->
  <section class="py-20 md:py-28 bg-navy/20 border-b border-border-subtle">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold text-gold uppercase tracking-widest mb-3">The Simple Machine</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          How intake works on a normal Tuesday.
        </p>
        <p class="mt-4 text-base text-slate-300">
          No 20-page instruction manual. A clean, 3-step loop your part-time counter clerk can learn in 5 minutes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- Step 1 -->
        <div class="p-8 rounded-2xl bg-black border border-border-subtle relative group hover:border-gold/50 transition-colors">
          <span class="text-5xl font-black text-slate-800 absolute top-6 right-6">1</span>
          <h3 class="text-xl font-bold text-white mb-3">Snap the Label</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-4">
            Point any tablet or phone camera at the shipping label. The system reads the carrier, tracking number, and customer name, auto-matching the mailbox in seconds.
          </p>
          <div class="text-xs font-medium text-gold">Generates short handling ID for the box</div>
        </div>

        <!-- Step 2 -->
        <div class="p-8 rounded-2xl bg-black border border-border-subtle relative group hover:border-gold/50 transition-colors">
          <span class="text-5xl font-black text-slate-800 absolute top-6 right-6">2</span>
          <h3 class="text-xl font-bold text-white mb-3">Instant Customer Alert</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-4">
            The moment you hit save, an automated SMS or email notifies the customer that their package is ready for pickup. No manual typing. No outbound phone calls.
          </p>
          <div class="text-xs font-medium text-gold">Stops the "Do I have mail?" calls</div>
        </div>

        <!-- Step 3 -->
        <div class="p-8 rounded-2xl bg-black border border-border-subtle relative group hover:border-gold/50 transition-colors">
          <span class="text-5xl font-black text-slate-800 absolute top-6 right-6">3</span>
          <h3 class="text-xl font-bold text-white mb-3">Digital Signature Release</h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-4">
            When they walk in, search the box number and hand over the screen. They sign with a finger. The timestamped signature is permanently logged in your secure audit trail.
          </p>
          <div class="text-xs font-medium text-gold">Permanent proof against missing-package claims</div>
        </div>
      </div>
    </div>
  </section>

  <!-- MIGRATION CALLOUT: ASSISTED ROSTER MIGRATION (D8) -->
  <section id="migration" class="py-20 bg-black border-b border-border-subtle">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-10 md:p-12 rounded-3xl bg-gradient-to-r from-navy to-navy-dark border border-gold/30 shadow-2xl">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-gold/10 border border-gold/30 text-xs font-semibold text-gold mb-6">
            Zero-Downtime Migration Included
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
            Terrified of switching systems? We load your roster for you.
          </h2>
          <p class="text-base sm:text-lg text-slate-200 leading-relaxed mb-8">
            You don't have to re-type 200 customer records while running a busy counter. Export your customer list from PostalMate, CashMate, or Excel, and bring it to your onboarding call. We format, sanitize, and seed your account before your first scan.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8 text-sm text-slate-300">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gold flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>CashMate & PostalMate export friendly</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gold flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Zero new hardware: use tablets you already own</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gold flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Run side-by-side with your old log on Day 1</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gold flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Multiple addressees per box supported</span>
            </div>
          </div>
          <a 
            href="https://cal.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center px-7 py-3.5 rounded-xl text-sm font-bold bg-gold text-black hover:bg-gold-hover transition-colors"
          >
            Book an Assisted Setup Call &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- THE COMPARISON GRID: LEGACY VENDOR VS MYMAILHUB -->
  <section id="comparison" class="py-20 md:py-28 bg-black border-b border-border-subtle">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold text-gold uppercase tracking-widest mb-3">Compare The Standard</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          What counter software should look like in 2026.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-border-subtle">
              <th class="py-4 px-6 text-sm font-bold text-slate-400">Feature</th>
              <th class="py-4 px-6 text-sm font-bold text-slate-400">Legacy Systems (e.g. PictaMail)</th>
              <th class="py-4 px-6 text-sm font-bold text-gold bg-navy/40 rounded-t-xl">MyMailhub Standard</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-subtle text-sm">
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Contract Terms</td>
              <td class="py-5 px-6 text-slate-400">Mandatory 6-month paper lease + 30-day cancellation notice</td>
              <td class="py-5 px-6 font-bold text-white bg-navy/40">$39/mo flat. No contracts. Cancel anytime.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Hardware Required</td>
              <td class="py-5 px-6 text-slate-400">Tethered flatbed/sheet-fed scanner hardware on your counter</td>
              <td class="py-5 px-6 font-bold text-white bg-navy/40">Zero hardware. Use any phone, iPad, or tablet camera.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Software Architecture</td>
              <td class="py-5 px-6 text-slate-400">Sideloaded Android APKs from web links; breaks on OS updates</td>
              <td class="py-5 px-6 font-bold text-white bg-navy/40">Zero-install secure cloud app. Works in any browser.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Data Safety & Storage</td>
              <td class="py-5 px-6 text-slate-400">Unencrypted local device storage. Drop the tablet = lose your data</td>
              <td class="py-5 px-6 font-bold text-white bg-navy/40">Encrypted in transit and rest. Multi-device continuous sync.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Notifications Setup</td>
              <td class="py-5 px-6 text-slate-400">Owner must register separate Twilio accounts & SMTP passwords</td>
              <td class="py-5 px-6 font-bold text-white bg-navy/40">Included out-of-the-box. Instant automated SMS & email.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Roster Migration</td>
              <td class="py-5 px-6 text-slate-400">Self-install manual guide; manual roster entry</td>
              <td class="py-5 px-6 font-bold text-white bg-navy/40">Assisted migration included on your onboarding call.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- GATED VIDEO DEMO (D5 Locked Lead Capture) -->
  <section id="demo" class="py-20 md:py-28 bg-navy/30 border-b border-border-subtle">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-navy border border-border-subtle text-xs font-semibold text-gold mb-6">
        2-Minute Uncut Counter Recording
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        See the actual counter workflow in action.
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-10">
        Watch an actual delivery intake from our front desk: label scan, automatic customer match, SMS alert, and signature release.
      </p>

      <!-- Email Gate Form -->
      <div class="p-8 rounded-3xl bg-black border border-border-subtle text-left shadow-2xl">
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you! Walkthrough video access sent.');">
          <div>
            <label for="owner-name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Store Owner Name</label>
            <input 
              type="text" 
              id="owner-name" 
              required 
              placeholder="e.g. Frank Schwarz" 
              class="w-full px-4 py-3 rounded-xl bg-navy/50 border border-border-subtle text-white placeholder-slate-500 focus:outline-none focus:border-gold"
            />
          </div>
          <div>
            <label for="owner-email" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Store Email Address</label>
            <input 
              type="email" 
              id="owner-email" 
              required 
              placeholder="frank@mailboxplusohio.com" 
              class="w-full px-4 py-3 rounded-xl bg-navy/50 border border-border-subtle text-white placeholder-slate-500 focus:outline-none focus:border-gold"
            />
          </div>
          <button 
            type="submit" 
            class="w-full py-4 rounded-xl text-base font-bold bg-gold text-black hover:bg-gold-hover transition-colors mt-2"
          >
            Send Me the Walkthrough Video
          </button>
          <p class="text-xs text-center text-slate-500 pt-2">
            No spam. We respect store operators. Unsubscribe anytime.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- VALUE MATH & PRICE ANCHOR -->
  <section class="py-20 md:py-28 bg-black text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xs font-bold text-gold uppercase tracking-widest mb-3">Simple Math</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-6">
        One extra mailbox renter pays for the entire software.
      </p>
      <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed">
        At $39/month flat, saving just 30 minutes of counter clerk labor a day pays for MyMailhub three times over. No onboarding fees, no hardware investments, and no multi-month leases.
      </p>
      <div class="inline-flex flex-col sm:flex-row items-center gap-4">
        <a 
          href="/pricing" 
          class="inline-flex items-center px-8 py-4 rounded-xl text-base font-bold bg-gold text-black hover:bg-gold-hover transition-colors"
        >
          View Pricing Breakdown ($39/mo) &rarr;
        </a>
        <a 
          href="https://cal.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center px-8 py-4 rounded-xl text-base font-semibold text-slate-300 border border-border-subtle hover:text-white hover:border-slate-400 transition-colors"
        >
          Book Your Onboarding Call
        </a>
      </div>
    </div>
  </section>
</Layout>
